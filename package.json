{
	"name": "@natlibfi/melinda-record-import-transformer-helmet",
	"description": "Helmet record transformer for the Melinda record batch import system",
	"author": {
		"name": "The National Library of Finland"
	},
	"keywords": [],
	"homepage": "https://github.com/natlibfi/melinda-record-import-transformer-helmet",
	"bugs": {
		"url": "https://github.com/natlibfi/melinda-record-import-transformer-helmet/issues"
	},
	"repository": {
		"type": "git",
		"url": "git@github.com:natlibfi/melinda-record-import-transformer-helmet.git"
	},
	"license": "MIT",
	"version": "1.0.6",
	"main": "./dist/index.js",
	"type": "module",
	"bin": "./dist/cli.js",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "esbuild \"src/**/*.js\" --sourcemap --platform=node --outdir=dist",
		"start": "node dist/index.js",
		"start:dev": "node src/index.js",
		"cli": "node dist/cli.js",
		"lint": "eslint ./src",
		"lint:dev": "eslint ./src --fix",
		"test:base": "node --test --test-force-exit --experimental-test-coverage --test-reporter=spec './src/*.test.js' './src/**/*.test.js'",
		"test": "npm run lint && npm run test:base",
		"watch:test": "cross-env DEBUG=@natlibfi/* NODE_ENV=test node --watch --test --experimental-test-coverage --test-reporter=spec './src/*.test.js' './src/**/*.test.js'",
		"dev": "npm run watch:test",
		"dev:debug": "cross-env LOG_LEVEL=debug DEBUG=@natlibfi/* NODE_ENV=test npm run watch:test"
	},
	"dependencies": {
		"@natlibfi/marc-record": "^10.0.0",
		"@natlibfi/marc-record-validate": "^9.0.0",
		"@natlibfi/marc-record-validators-melinda": "^12.0.0",
		"@natlibfi/melinda-backend-commons": "^3.0.0",
		"@natlibfi/melinda-commons": "^14.0.1",
		"@natlibfi/melinda-record-import-commons": "^13.0.0",
		"amqplib": "^0.10.9",
		"debug": "^4.4.3",
		"moment": "^2.30.1",
		"stream-chain": "^3.4.0",
		"stream-json": "^1.9.1"
	},
	"devDependencies": {
		"@natlibfi/fixugen": "^3.0.0",
		"@natlibfi/fixura": "^4.0.0",
		"cross-env": "^10.1.0",
		"esbuild": "^0.27.0",
		"eslint": "^9.39.1"
	},
	"overrides": {
		"nanoid": "^3.3.8"
	}
}
